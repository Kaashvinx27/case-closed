# CASE CLOSED Environment Variables
# Copy this file to .env and adjust your configuration

DJANGO_SECRET_KEY=case-closed-classified-noir-investigation-secret-key-2026
DJANGO_DEBUG=True

# Database Configuration
# Options: 'sqlite' or 'mysql'
